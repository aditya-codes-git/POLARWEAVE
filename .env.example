# ===================================================
# POLARWEAVE — ENVIRONMENT CONFIGURATION
# ===================================================

# -----------------------------
# FRONTEND / CLIENT-SIDE (VITE_)
# -----------------------------
# Supabase URL & Public Anon Key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here

# API URL for POLARWEAVE backend
VITE_API_URL=http://localhost:5000

# Demo Mode: set to true to enable realistic demonstration data and simulated pipelines
# Allows full SIH presentation and Evidence Trace evaluation without active cloud keys
VITE_DEMO_MODE=true

# -----------------------------
# BACKEND SERVER CONFIGURATION
# -----------------------------
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Supabase Server-Side Admin Credentials (NEVER expose to client)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# -----------------------------
# AI & MULTIMODAL EXTRACTION
# -----------------------------
GEMINI_API_KEY=your-gemini-api-key-here

# -----------------------------
# STORAGE & PROCESSING
# -----------------------------
MAX_UPLOAD_SIZE_MB=100

# Optional path to local FFmpeg executable if not in system PATH
# FFMPEG_PATH=/usr/bin/ffmpeg
